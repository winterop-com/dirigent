# Fills in ${...} in compose.yaml. Dirigent's own settings are in dirigent.yaml.
# Copy to .env and fill in the two values that have no safe default.

# --- the two you must set --------------------------------------------------------------

# Generate one with:
#
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# Losing it means losing every stored connection secret. Changing it does not re-encrypt
# what is already stored.
DIRIGENT_SECRET_KEY=

# One-way: it does nothing the moment any account exists, so leaving it set on every deploy
# cannot reset a live instance's password.
DIRIGENT_BOOTSTRAP_ADMIN_PASSWORD=

# --- database ---------------------------------------------------------------------------

POSTGRES_USER=dirigent
POSTGRES_PASSWORD=dirigent
POSTGRES_DB=dirigent
POSTGRES_PORT=5432

# Overrides the URL compose builds from the four variables above; that service still starts,
# so use `--scale postgres=0` to drop it. The driver has to be asyncpg, and TLS is a query
# parameter:
#
#   DIRIGENT_DATABASE_URL=postgresql+asyncpg://user:password@db.example.com:5432/dirigent?ssl=require

# --- the instance -------------------------------------------------------------------------

DIRIGENT_ENVIRONMENT=prod
DIRIGENT_PORT=3333
DIRIGENT_LOG_LEVEL=INFO

DIRIGENT_ALERT_BASE_URL=http://localhost:3333

DIRIGENT_WORKER_CONCURRENCY=8

# Pool size plus max overflow must be at least DIRIGENT_WORKER_CONCURRENCY plus 4: one
# connection per in-flight block call, plus the lease heartbeat, the sweeper, the alert loop
# and a spare. Starve the heartbeat and leases expire under load, the sweeper reclaims live
# attempts, and non-idempotent work runs twice. The instance refuses to start on a
# configuration where that can happen, so raising the concurrency means raising these too.
DIRIGENT_DATABASE_POOL_SIZE=12
DIRIGENT_DATABASE_MAX_OVERFLOW=4

DIRIGENT_SCHEDULER_ENABLED=true

# --- storage ------------------------------------------------------------------------------

# The stack keeps artifacts in the bucket below, and compose sets DIRIGENT_ARTIFACT_ROOT and
# DIRIGENT_STORAGE_CONNECTIONS from these four. The `migrate` service writes the connection
# S3_CONNECTION names from S3_ACCESS_KEY and S3_SECRET_KEY, so the credentials live here and
# nowhere else; change one and the next `up` brings the row to it.
S3_ACCESS_KEY=dirigent
S3_SECRET_KEY=dirigent
S3_BUCKET=dirigent
S3_CONNECTION=artifacts

# Artifacts are storage and shared; a checkout, a build context, a compose file and a bind
# mount are files a tool opens, so they go on the worker's own disk instead. The stack keeps
# that on the `work` volume, which the docker sidecar mounts at the same path so a bind means
# the same directory on both sides. Compose sets it; this is where to move it.
#
#   DIRIGENT_WORK_ROOT=/var/lib/dirigent/work

# Where the bundled S3 server is published for a person on the host; the stack itself reaches
# it as http://s3:9000. Point DIRIGENT_ARTIFACT_ROOT and the connection at your own bucket to
# use one instead: any S3-compatible server works, and nothing in dirigent depends on this one.
S3_PORT=9010
DIRIGENT_S3_IMAGE=rustfs/rustfs:1.0.0-rc.4

# --- opt-in danger ------------------------------------------------------------------------

# Comma-separated block ids, empty for none. Listing one means whoever can edit a pipeline
# can run code on a worker. The docker.* blocks reach the dind sidecar this stack starts, so
# they cost the sidecar rather than the host.
#
#   DIRIGENT_ENABLED_UNSAFE_BLOCKS=shell.run,docker.run,docker.compose.up,docker.compose.down
DIRIGENT_ENABLED_UNSAFE_BLOCKS=

# --- telemetry ----------------------------------------------------------------------------

# The image built here ships the OTLP exporter, so naming an endpoint is all telemetry
# needs. infra/compose.otel.yaml sets these for you and starts somewhere to send them.
#
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#   OTEL_SERVICE_NAME=dirigent

# Where the telemetry overlay's Grafana listens. 3333 is the server and 3334 the docs.
GRAFANA_PORT=3300

# --- brokers, used only by compose.brokers.yaml -------------------------------------------

# Neither broker publishes an AMQP or Kafka port: the stack reaches them by service name.
# This is the one mapping, and it is the management UI a person watches a queue drain in.
RABBITMQ_USER=dirigent
RABBITMQ_PASSWORD=dirigent
RABBITMQ_MANAGEMENT_PORT=15672

DIRIGENT_KAFKA_IMAGE=redpandadata/redpanda:v24.2.18
DIRIGENT_RABBITMQ_IMAGE=rabbitmq:3-management-alpine

# --- alert sinks, used only by compose.sinks.yaml -------------------------------------------

# Where an alert lands when you want to see one arrive. Mailpit publishes its web UI and its
# JSON API on this port; its SMTP port stays inside the network, and the email connection
# submits to `mailpit:1025` by service name. The webhook sink answers 200 to anything and
# prints what it got.
MAILPIT_WEB_PORT=8025
WEBHOOK_SINK_PORT=8099

DIRIGENT_MAILPIT_IMAGE=axllent/mailpit:v1.21.8
DIRIGENT_WEBHOOK_SINK_IMAGE=mendhak/http-https-echo:36

# --- the warehouse, used only by compose.sql.yaml ------------------------------------------

# A second PostgreSQL, separate from the one above: that one is dirigent's database, this one
# is data a pipeline reads. The two role passwords are what the sql connections carry.
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse
WAREHOUSE_DB=warehouse
WAREHOUSE_PORT=5433
WAREHOUSE_READER_PASSWORD=reader-password
WAREHOUSE_WRITER_PASSWORD=writer-password
