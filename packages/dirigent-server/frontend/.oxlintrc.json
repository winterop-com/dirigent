{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["react", "typescript", "unicorn", "oxc"],
    "env": {
        "browser": true,
        "es2024": true
    },
    "categories": {
        "correctness": "error",
        "suspicious": "warn",
        "perf": "warn"
    },
    "rules": {
        "eqeqeq": "error",
        "no-console": [
            "warn",
            {
                "allow": ["warn", "error"]
            }
        ],
        "typescript/no-explicit-any": "error",
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn",
        "react/react-in-jsx-scope": "off"
    },
    "ignorePatterns": ["node_modules", "dist", "src/components/ui"],
    "overrides": [
        {
            "files": ["e2e/**", "shots-src/**", "docs-shots-src/**", "*.config.ts"],
            "rules": {
                "no-await-in-loop": "off"
            }
        },
        {
            "files": ["e2e/**", "shots-src/**", "docs-shots-src/**", "**/*.test.ts", "**/*.test.tsx"],
            "rules": {
                "unicorn/consistent-function-scoping": "off"
            }
        }
    ]
}
